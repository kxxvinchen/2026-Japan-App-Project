rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDirector() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/directors/$(request.auth.token.email));
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function isChaperone() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/chaperones/$(request.auth.token.email));
    }
    // Helper function to check if the user is in the notification tester database group
    function isNotificationTester() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/$("notification tester")/$(request.auth.token.email));
    }
    // Performers / Shadow / Flights / Percussion are public-read announcement channels.
    // The test channel is only readable by members of the notification tester group.
    function canRead(ch) {
      return ch in ['performers', 'shadow', 'flights', 'percussion']
        || isDirector()
        || (ch == 'chaperones' && (isAdmin() || isChaperone()))
        || (ch == 'test' && isNotificationTester());
    }
    match /channels/{ch}/messages/{id} {
      allow read: if canRead(ch);
      // Flights & Directors: directors only. Performers/Shadow: directors or admins.
      // Chaperones: directors, admins, or chaperone.
      // Test channel: notification testers.
      allow create: if (
            isDirector()
            || (ch == 'chaperones' && (isAdmin() || isChaperone()))
            || ((ch == 'performers' || ch == 'shadow') && isAdmin())
            || (ch == 'test' && isNotificationTester())
          )
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if isDirector()
        || (ch == 'chaperones' && (isAdmin() || isChaperone()))
        || ((ch == 'performers' || ch == 'shadow') && isAdmin())
        || (ch == 'test' && isNotificationTester());
    }
    // Consolidated matcher to handle collection names containing spaces
    match /{col}/{email} {
      allow get: if col in ['directors', 'admins', 'chaperones', 'notification tester']
        && request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }
    match /webTokens/{id} {
      allow read, list: if false;
      allow create, update: if request.resource.data.token is string
        && request.resource.data.token.size() < 1000
        && request.resource.data.channels is list
        && request.resource.data.channels.size() <= 10
        && (request.resource.data.channels.hasOnly(['performers', 'shadow', 'flights', 'percussion']) || request.auth != null);
      allow delete: if false;
    }
    match /reminders/{id} {
      allow read, list: if false;
      allow create, update: if request.resource.data.token is string
        && request.resource.data.token.size() < 1000
        && request.resource.data.fireAtMs is number
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow delete: if true;
    }
    match /sentReminders/{id} {
      allow read, list, write: if false;
    }
  }
}
